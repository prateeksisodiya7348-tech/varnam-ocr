# =============================================================================
# Varnam OCR - environment contract
# Copy to `.env` for local development. NEVER commit the real `.env`.
# Every variable below is read through services/api/app/config.py (Settings).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
# development | production. Production enables strict CORS + JSON logs only.
APP_ENV=development

# --- Database --------------------------------------------------------------
# Local default is SQLite so a fresh clone runs with zero setup.
# Production uses Neon's pooled Postgres connection string (sslmode=require).
DATABASE_URL=sqlite:///./varnam.db

# --- Inference engine ------------------------------------------------------
# fake  -> deterministic stub text, zero model files, instant start (used in CI)
# onnx  -> load models from MODEL_DIR; fails loudly if they are missing
# auto  -> use onnx when MODEL_DIR contains a recognition model, else fake
VARNAM_ENGINE=auto

# Directory holding recognition model + charset. Baked into the Docker image
# at /app/models in production; ignored when VARNAM_ENGINE=fake.
MODEL_DIR=./models

# Rec model filename inside MODEL_DIR, and the mapping of CTC output index to
# Devanagari character (one character per line, index 0 is the CTC blank).
REC_MODEL_FILE=rec.onnx
CHARSET_FILE=charset.txt

# Threads for onnxruntime. Free Render instances have 1 vCPU, so 1 is optimal;
# raising it only adds context-switch overhead and RSS.
ORT_INTRA_OP_THREADS=1

# --- Upload limits ---------------------------------------------------------
# Hard ceilings that protect the 512MB free-tier instance from OOM.
MAX_UPLOAD_MB=10
MAX_IMAGE_LONG_EDGE=2000
MAX_PAGES_PER_JOB=20

# Per-request wall clock budget in seconds. Keep below the platform timeout so
# the client receives a structured 503 instead of a proxy error page.
REQUEST_TIMEOUT_SECONDS=25

# --- Abuse protection ------------------------------------------------------
# Simple in-process token bucket; see app/core/ratelimit.py for the tradeoff.
RATE_LIMIT_PER_MINUTE=20

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist. Must include the Vercel production + preview URLs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage ---------------------------------------------------------------
# local -> ./uploads on disk (dev). r2 -> Cloudflare R2 via S3 API (prod).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads

# Only required when STORAGE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=varnam-ocr

# --- Public wiring ---------------------------------------------------------
# Used by the Next.js build (apps/web). Set on Vercel to the Render URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Shared secret that lets the web app bypass the per-IP bucket during demos.
# Empty in dev = disabled.
API_SHARED_SECRET=
