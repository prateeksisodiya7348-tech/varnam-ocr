# Copy to `.env.local` for local development. Next.js reads this file, and only
# variables prefixed with NEXT_PUBLIC_ are exposed to the browser — which is why
# no secret ever belongs here.

# Base URL of the FastAPI service.
# Local: http://127.0.0.1:8000
# Vercel: https://varnam-ocr-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
